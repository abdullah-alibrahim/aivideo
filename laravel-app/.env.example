APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Set true before exposing the studio outside localhost. Uses HTTP Basic Auth.
STUDIO_AUTH_ENABLED=false
STUDIO_AUTH_USERNAME=
STUDIO_AUTH_PASSWORD=
STUDIO_MAX_VIDEO_MB=100
STUDIO_MAX_MUSIC_MB=20
STUDIO_MAX_CONCURRENT_RENDERS=1
STUDIO_MIN_FREE_SPACE_MB=1024
STUDIO_RENDER_LOCK_SECONDS=900
STUDIO_STALE_AFTER_MINUTES=30
# Rendering runs in a queue worker; keep this above the longest expected render.
STUDIO_RENDER_TIMEOUT_SECONDS=900
# Optional overrides for the Python engine location.
AIVIDEO_PYTHON_BIN=
AIVIDEO_ENGINE_SCRIPT=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Production alternative: DB_CONNECTION=pgsql (configure DB_HOST/PORT/DATABASE/USERNAME/PASSWORD below)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=1500
# Production alternative: QUEUE_CONNECTION=redis
# REDIS_QUEUE_RETRY_AFTER=1320

# Python renderer: licensed Arabic font path on Linux (e.g. Noto Sans Arabic).
AIVIDEO_ARABIC_FONT=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Optional legacy ElevenLabs key fallback; you can also add multiple encrypted keys in the app's Provider Key Manager.
ELEVENLABS_API_KEY=
# Optional Voice ID fallbacks; values set in Provider Key Manager take precedence.
ELEVENLABS_VOICE_ID_AR=
ELEVENLABS_VOICE_ID_EN=
